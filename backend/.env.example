# ─────────────────────────────────────────────────────────────────────────────
# AI SupportOps — Backend Environment Configuration
# Copy this file to .env and fill in real values before running.
# Never commit .env to source control.
# ─────────────────────────────────────────────────────────────────────────────

# ── App ───────────────────────────────────────────────────────────────────────
APP_NAME="AI SupportOps"
APP_VERSION="0.1.0"
ENVIRONMENT="development"            # development | staging | production
DEBUG=true
SECRET_KEY="change-me-to-a-random-64-char-hex-string"
ALLOWED_HOSTS="localhost,127.0.0.1"

# ── API ───────────────────────────────────────────────────────────────────────
API_V1_PREFIX="/api/v1"
# List fields: use plain comma-separated values (no quotes, no JSON brackets)
BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
ALLOWED_HOSTS=localhost,127.0.0.1

# ── JWT Auth ──────────────────────────────────────────────────────────────────
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_HOST="localhost"
POSTGRES_PORT=5432
POSTGRES_DB="supportops"
POSTGRES_USER="supportops"
POSTGRES_PASSWORD="change-me"
# Constructed automatically from above — override if needed:
# DATABASE_URL="postgresql+asyncpg://supportops:change-me@localhost:5432/supportops"

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=""
# REDIS_URL="redis://localhost:6379/0"

# ── ChromaDB ──────────────────────────────────────────────────────────────────
CHROMA_HOST="localhost"
CHROMA_PORT=8001
CHROMA_COLLECTION_NAME="supportops_kb"

# ── LLM / OpenAI ─────────────────────────────────────────────────────────────
OPENAI_API_KEY="sk-..."
OPENAI_DEFAULT_MODEL="gpt-4o"
OPENAI_FAST_MODEL="gpt-4o-mini"

# ── LangSmith ────────────────────────────────────────────────────────────────
LANGCHAIN_TRACING_V2=true
LANGCHAIN_ENDPOINT="https://api.smith.langchain.com"
LANGCHAIN_API_KEY="ls__..."
LANGCHAIN_PROJECT="ai-supportops"

# ── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=100

# ── Sentry ────────────────────────────────────────────────────────────────────
SENTRY_DSN=""
SENTRY_TRACES_SAMPLE_RATE=0.1

# ── Email / Notifications ────────────────────────────────────────────────────
SENDGRID_API_KEY=""
NOTIFICATION_FROM_EMAIL="noreply@supportops.ai"

# ── Pagination ────────────────────────────────────────────────────────────────
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100
