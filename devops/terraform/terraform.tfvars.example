# ─────────────────────────────────────────────────────────────────────────────
# AI SupportOps — Example Terraform Variables
# Copy this to terraform.tfvars and fill in your values:
#   cp terraform.tfvars.example terraform.tfvars
# ─────────────────────────────────────────────────────────────────────────────

aws_region       = "us-east-1"
project_name     = "ai-supportops"
environment      = "dev"
instance_type    = "t3.medium"              # Minimum for k3s + all pods
key_pair_name    = "your-key-pair-name"      # ← CHANGE THIS to your AWS key pair
root_volume_size = 30
ssh_allowed_cidr = ["0.0.0.0/0"]             # ← Restrict to your IP for security

# ─────────────────────────────────────────────────────────────────────────────
# Notes:
#   - Jenkins is NOT publicly exposed. Access via SSH tunnel:
#     ssh -i ~/.ssh/<key>.pem -L 8082:localhost:30082 ubuntu@<ELASTIC_IP>
#     Then open http://localhost:8082 in your browser.
#
#   - App is accessible at http://<ELASTIC_IP>:30080
#   - Swagger/docs are disabled in production (ENVIRONMENT=production)
# ─────────────────────────────────────────────────────────────────────────────
