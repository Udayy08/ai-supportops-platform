# ─────────────────────────────────────────────────────────────────────────────
# AI SupportOps — Kubernetes Secrets (EXAMPLE)
#
# ⚠️  DO NOT commit real values to source control!
#
# Option 1: Create from this template
#   1. Copy this file:  cp secrets.yaml.example secrets.yaml
#   2. Replace the base64 values with your real secrets
#   3. Apply:  kubectl apply -f secrets.yaml
#
# Option 2: Create via kubectl (recommended)
#   kubectl create secret generic app-secrets \
#     --namespace=supportops \
#     --from-literal=SECRET_KEY="your-64-char-random-hex-string-here-change-me-now" \
#     --from-literal=POSTGRES_PASSWORD="your-strong-db-password" \
#     --from-literal=GROQ_API_KEY="gsk_your_groq_api_key" \
#     --from-literal=LANGCHAIN_API_KEY="ls__your_langchain_key" \
#     --from-literal=SENTRY_DSN="" \
#     --from-literal=SENDGRID_API_KEY=""
# ─────────────────────────────────────────────────────────────────────────────

apiVersion: v1
kind: Secret
metadata:
  name: app-secrets
  namespace: supportops
  labels:
    app.kubernetes.io/part-of: ai-supportops
type: Opaque
data:
  # Base64-encoded values — replace these with your real secrets!
  # To encode: echo -n "your-value" | base64
  SECRET_KEY: Y2hhbmdlLW1lLXRvLWEtcmFuZG9tLTY0LWNoYXItaGV4LXN0cmluZw==
  POSTGRES_PASSWORD: c3VwcG9ydG9wc19kZXZfcGFzc3dvcmQ=
  GROQ_API_KEY: Z3NrX3lvdXJfZ3JvcV9hcGlfa2V5
  LANGCHAIN_API_KEY: bHNfX3lvdXJfbGFuZ2NoYWluX2tleQ==
  SENTRY_DSN: ""
  SENDGRID_API_KEY: ""
